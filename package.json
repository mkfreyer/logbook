{
  "name": "logbook",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:db && npm run test:navigation && npm run test:ui && npm run test:model-viewer && npm run test:upgrade",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "test:db": "tsx --test tests/db.test.ts tests/m1-db.test.ts tests/m12-db.test.ts tests/m2-db.test.ts tests/m2-summary.test.ts tests/m3-history.test.ts tests/m32-data.test.ts tests/m33-data.test.ts tests/m34a-data.test.ts tests/m34b-data.test.ts tests/set-passages-data.test.ts tests/m34c-data.test.ts",
    "test:ui": "jest --runInBand",
    "test:navigation": "tsx --test tests/navigation.test.ts",
    "viewer:build": "node tools/m4b/build-viewer.mjs",
    "viewer:check": "node tools/m4d/build-selection.mjs --check && node tools/m4b/build-viewer.mjs --check",
    "test:model-viewer": "tsx --test tests/model-viewer.test.ts tests/muscle-selection.test.ts",
    "test:viewer-browser": "tsx tools/m4b/test-browser.ts",
    "test:upgrade": "tsx --test tests/sdk58-preservation.test.ts",
    "test:selection-browser": "tsx tools/m4d/test-selection-browser.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-sharing": "~58.0.20",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "~14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "@types/three": "0.186.0",
    "babel-preset-expo": "~58.0.0",
    "esbuild": "0.28.2",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "playwright": "1.64.1",
    "test-renderer": "1.3.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
